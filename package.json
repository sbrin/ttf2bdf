{
    "name": "truetype2bdf",
    "version": "1.1.1",
    "description": "Convert TTF or OTF fonts to BDF bitmap font format",
    "author": "Mikhail Ilin",
    "license": "MIT",
    "type": "module",
    "module": "dist/truetype2bdf.min.js",
    "types": "dist/types/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/truetype2bdf.min.js",
            "types": "./dist/types/index.d.ts"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
        "prebuild": "npm run clean",
        "build": "rollup -c",
        "watch": "rollup -c -w",
        "prepublishOnly": "npm run build",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@rollup/plugin-commonjs": "^28.0.9",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.3.0",
        "@types/node": "^25.9.5",
        "@types/opentype.js": "^1.3.10",
        "@vitest/coverage-v8": "^3.2.7",
        "jsdom": "^29.1.1",
        "rollup": "^4.62.4",
        "tslib": "^2.8.1",
        "typescript": "^5.9.3",
        "vitest": "^3.1.2"
    },
    "dependencies": {
        "opentype.js": "1.3.4"
    },
    "overrides": {
        "serialize-javascript": "^7.0.7"
    },
    "keywords": [
        "fontconvert",
        "bdf",
        "truetype",
        "ttf2bdf",
        "otf2bdf",
        "embedded",
        "u8g2"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sbrin/ttf2bdf.git"
    },
    "bugs": {
        "url": "https://github.com/sbrin/ttf2bdf/issues"
    },
    "homepage": "https://github.com/sbrin/ttf2bdf#readme"
}
